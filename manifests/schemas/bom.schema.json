{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrenet-os.example/schemas/bom.schema.json",
  "title": "Cyrenet OS Package BOM Schema",
  "description": "Schema for package Bill of Materials files enforcing all 11 metadata fields from PROJECT.md §11.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "upstream_version",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "type": "string",
      "enum": ["core", "standard", "extended"]
    },
    "upstream_version": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source_repo",
          "source_commit",
          "license",
          "dependencies",
          "profiles",
          "default_enabled",
          "is_kmod",
          "requires_extra_config",
          "conflicts"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Package name (e.g., luci-app-cyrenet-dns, adguardhome)."
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source_repo": {
            "type": "string",
            "minLength": 1
          },
          "source_commit": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "description": "SPDX license identifier or expression; must never be silently overridden."
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["core", "standard", "extended"] },
            "uniqueItems": true
          },
          "default_enabled": {
            "type": "boolean",
            "description": "Whether the service runs enabled by default at first boot."
          },
          "is_kmod": {
            "type": "boolean",
            "description": "Whether this package is a kernel module sensitive to kernel ABI."
          },
          "requires_extra_config": {
            "type": "boolean"
          },
          "conflicts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
