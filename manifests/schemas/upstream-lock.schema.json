{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrenet-os.example/schemas/upstream-lock.schema.json",
  "title": "Cyrenet OS Upstream Lock Schema",
  "description": "Schema for manifests/upstream.lock.yaml locking ImmortalWrt, feeds, and third-party sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upstream",
    "feeds",
    "third_party",
    "verified_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "verified_at": {
      "type": "string",
      "pattern": "^(TBD|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$",
      "description": "UTC ISO-8601 timestamp when commits were verified, or TBD during M0 offline scaffolding."
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "branch", "tag", "repo_url", "commit", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "repo_url": { "type": "string", "pattern": "^https://" },
        "commit": {
          "type": "string",
          "pattern": "^(TBD|[0-9a-f]{40})$",
          "description": "Full 40-char git commit SHA, or TBD prior to M0 Step 3 online verification."
        },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repo_url", "branch", "commit", "license"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "repo_url": { "type": "string", "pattern": "^https://" },
          "branch": { "type": "string", "minLength": 1 },
          "commit": {
            "type": "string",
            "pattern": "^(TBD|[0-9a-f]{40})$"
          },
          "license": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "third_party": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repo_url", "ref", "commit", "license"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "repo_url": { "type": "string", "pattern": "^https://" },
          "ref": { "type": "string", "minLength": 1 },
          "commit": {
            "type": "string",
            "pattern": "^(TBD|[0-9a-f]{40})$"
          },
          "license": { "type": "string", "minLength": 1 },
          "profiles": {
            "type": "array",
            "items": { "type": "string", "enum": ["core", "standard", "extended"] },
            "uniqueItems": true
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
