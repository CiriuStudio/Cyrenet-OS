# Cyrenet OS — Extended Profile delta config fragment.
# Inherits: config/common.config + profiles/core/profile.config + profiles/standard/profile.config
# Note: SFE is excluded here and isolated in config/experimental/.

# Multi-WAN & policy routing (default disabled)
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# Multi-dial (default disabled; IPv6 compatibility tested separately in M6)
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_luci-app-syncdial=y

# L2 historical metrics (collectd) & L3 Prometheus exporter (external listener default disabled)
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE_prometheus-node-exporter-lua=y
