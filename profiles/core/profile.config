# Cyrenet OS — Core Profile delta config fragment.
# Inherits: config/common.config

# DDNS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# DNS ad-blocking engines (AdGuard Home default active; Adblock Fast mutually exclusive)
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_adblock-fast=y
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn=y

# Per-device traffic statistics
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# Self-developed Cyrenet Core packages (enable incrementally in M2–M5):
# CONFIG_PACKAGE_luci-theme-cyrenet=y
# CONFIG_PACKAGE_luci-app-cyrenet-dns=y
# CONFIG_PACKAGE_luci-app-cyrenet-diagnostics=y
# CONFIG_PACKAGE_luci-app-cyrenet-backup=y
# CONFIG_PACKAGE_luci-app-cyrenet-updater=y
