#
# Cyrenet OS — Standard Profile delta config fragment.
# Inherits: config/common.config + profiles/core/profile.config
# Policy: all optional Homelab/proxy/QoS/remote-access services default to disabled.

# Remote mesh VPN
CONFIG_PACKAGE_tailscale=y

# Upstream DNS orchestrator
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# SQM / CAKE traffic shaping
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_kmod-sched-cake=y

# UPnP (default disabled)
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# NAT traversal
CONFIG_PACKAGE_natmap=y
CONFIG_PACKAGE_luci-app-natmap=y
CONFIG_PACKAGE_luci-i18n-natmap-zh-cn=y

# ACME certificate management
CONFIG_PACKAGE_acme-acmesh=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y

# Experimental BBR congestion control module (default disabled per PROJECT.md §7.4)
CONFIG_PACKAGE_kmod-tcp-bbr=y

# M3 integrations & self-developed Standard packages (enable after ADR-0004 / M3):
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-cyrenet-network=y
# CONFIG_PACKAGE_luci-app-cyrenet-performance=y
