# Cyrenet OS common Buildroot config fragment (M0 Verified Baseline).
# Exact Kconfig resolution is finalized via `make defconfig` on ImmortalWrt v25.12.2 in M1.

# Target platform: x86_64 generic UEFI + SquashFS + APK
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=300
CONFIG_USE_APK=y

# Reproducibility & build audit artifacts
CONFIG_BUILD_LOG=y
CONFIG_JSON_CYCLONEDX_SBOM=y

# Core networking & firewall4 stack (replace stripped dnsmasq with dnsmasq-full)
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y

# Native LuCI & HTTPS / localization baseline
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# HTTPS fetch & TLS trust store
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

# Software Flow Offloading module (preinstalled; default disabled per PROJECT.md §7.2)
CONFIG_PACKAGE_kmod-nft-offload=y
