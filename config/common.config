#
# Cyrenet OS common Buildroot config fragment (M0 DRAFT).
# Status: DRAFT — exact Kconfig symbol availability and default packages MUST be
# verified via `make defconfig` against locked ImmortalWrt 25.12.2 in M0 Step 3 / M1.
#
# Target baseline (PROJECT.md §2.2, §2.4, §2.5):
# - Architecture: x86_64 (generic UEFI)
# - RootFS: SquashFS + writable overlay (primary)
# - Package manager: APK (ImmortalWrt 25.12 native)

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# UEFI boot & primary SquashFS rootfs layout
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Package manager (APK on ImmortalWrt 25.12)
CONFIG_USE_APK=y
