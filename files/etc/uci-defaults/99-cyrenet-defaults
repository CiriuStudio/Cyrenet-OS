# Cyrenet OS first-boot defaults (PROJECT.md §1.3 / §2 / §7.2).
# Preinstalled optional services and accelerators must start disabled on first boot
# without altering default WAN-deny firewall policy, setting passwords, or hardcoding NICs.

current_hostname="$(uci -q get system.@system[0].hostname || true)"
case "$current_hostname" in
	""|OpenWrt|ImmortalWrt)
		if uci -q get system.@system[0] >/dev/null 2>&1; then
			uci -q set system.@system[0].hostname='CyrenetOS'
			uci -q commit system
		fi
		;;
esac

for svc in \
	adblock-fast \
	ddns \
	tailscale \
	smartdns \
	sqm \
	miniupnpd \
	natmap \
	mwan3 \
	collectd \
	prometheus-node-exporter-lua \
	openclash
do
	if [ -x "/etc/init.d/$svc" ]; then
		"/etc/init.d/$svc" disable >/dev/null 2>&1 || true
		"/etc/init.d/$svc" stop >/dev/null 2>&1 || true
	fi
done

if [ -f /etc/config/firewall ] && uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
	uci -q set firewall.@defaults[0].flow_offloading='0'
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	uci -q commit firewall
fi

if [ -f /etc/config/upnpd ] && uci -q get upnpd.config >/dev/null 2>&1; then
	uci -q set upnpd.config.enabled='0'
	uci -q commit upnpd
fi

if [ -f /etc/config/prometheus-node-exporter-lua ] && uci -q get prometheus-node-exporter-lua.main >/dev/null 2>&1; then
	uci -q set prometheus-node-exporter-lua.main.listen_interface='lan'
	uci -q commit prometheus-node-exporter-lua
fi

exit 0
